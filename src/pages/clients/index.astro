---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="客户端下载与配置中心 - 机场湾" description="涵盖 Clash Verge, Shadowrocket, v2rayN 等所有主流客户端的下载与订阅配置教程。">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h1 class="text-3xl font-bold mb-8">客户端中心</h1>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="bg-white dark:bg-midnight p-6 rounded-xl shadow-sm border border-gray-100 dark:border-gray-800">
        <h2 class="text-xl font-bold mb-2 text-cyan-blue">Windows</h2>
        <ul class="space-y-2 list-disc pl-5">
          <li>Clash Verge Rev</li>
          <li>v2rayN</li>
        </ul>
      </div>
      <div class="bg-white dark:bg-midnight p-6 rounded-xl shadow-sm border border-gray-100 dark:border-gray-800">
        <h2 class="text-xl font-bold mb-2 text-cyan-blue">macOS</h2>
        <ul class="space-y-2 list-disc pl-5">
          <li>Clash Verge Rev</li>
          <li>Surge</li>
        </ul>
      </div>
      <div class="bg-white dark:bg-midnight p-6 rounded-xl shadow-sm border border-gray-100 dark:border-gray-800">
        <h2 class="text-xl font-bold mb-2 text-cyan-blue">iOS</h2>
        <ul class="space-y-2 list-disc pl-5">
          <li>Shadowrocket (小火箭)</li>
          <li>Quantumult X</li>
          <li>Stash</li>
        </ul>
      </div>
      <div class="bg-white dark:bg-midnight p-6 rounded-xl shadow-sm border border-gray-100 dark:border-gray-800">
        <h2 class="text-xl font-bold mb-2 text-cyan-blue">Android</h2>
        <ul class="space-y-2 list-disc pl-5">
          <li>Clash Meta for Android</li>
          <li>v2rayNG</li>
          <li>sing-box</li>
        </ul>
      </div>
    </div>
  </div>
</Layout>
