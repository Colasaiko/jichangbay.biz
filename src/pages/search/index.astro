---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { airports } from '../../data/airports';
import { questions } from '../../data/questions';

const posts = await getCollection('blog');
const searchData = [
  ...posts.map(p => ({ title: p.data.title, desc: p.data.description, url: `/blog/${p.slug}`, type: '文章', aliases: '' })),
  ...airports.map(a => ({ title: a.name, desc: a.recommendedFor, url: `/airports/${a.slug}`, type: '机场', aliases: (a.searchAliases || []).join(' ') })),
  ...questions.map(q => ({ title: q.question, desc: q.shortAnswer, url: `/questions/${q.slug}`, type: '常见问题', aliases: (q.searchAliases || []).join(' ') }))
];
---
<Layout title="全站搜索 - 机场湾" description="在机场湾搜索评测文章、品牌详情与客户端教程。">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 min-h-[60vh]">
    <div class="text-center mb-10">
      <h1 class="text-4xl font-bold mb-4">全站搜索</h1>
      <p class="text-gray-600 dark:text-gray-400">快速查找机场测评、客户端教程或常见问题。</p>
    </div>
    
    <div class="relative max-w-2xl mx-auto mb-12">
      <input 
        type="text" 
        id="search-input" 
        placeholder="输入关键词，例如：Clash, 便宜机场, IPLC..." 
        class="w-full px-6 py-4 rounded-xl border border-gray-300 dark:border-gray-700 bg-white dark:bg-midnight text-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-cyan-blue dark:focus:ring-cyan-blue/50 transition"
      />
      <div class="absolute right-4 top-4 text-gray-400">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
      </div>
    </div>
    
    <div id="search-results" class="space-y-4 max-w-2xl mx-auto">
      <div class="text-center text-gray-500 mt-8" id="search-initial">输入关键词开始搜索...</div>
    </div>
  </div>
</Layout>

<script is:inline define:vars={{ searchData }}>
  const input = document.getElementById('search-input');
  const results = document.getElementById('search-results');
  const initial = document.getElementById('search-initial');

  input.addEventListener('input', (e) => {
    const query = e.target.value.toLowerCase().trim();
    if (!query) {
      results.innerHTML = '';
      results.appendChild(initial);
      initial.style.display = 'block';
      return;
    }

    const matches = searchData.filter(item => 
      item.title.toLowerCase().includes(query) || 
      item.desc.toLowerCase().includes(query) ||
      (item.aliases && item.aliases.toLowerCase().includes(query))
    ).slice(0, 10);

    if (matches.length === 0) {
      results.innerHTML = '<div class="text-center text-gray-500 mt-8">未找到匹配的内容，换个关键词试试？</div>';
      return;
    }

    results.innerHTML = matches.map(item => `
      <a href="${item.url}" class="block bg-white dark:bg-midnight p-6 rounded-xl border border-gray-100 dark:border-gray-800 shadow-sm hover:shadow-md transition group">
        <div class="flex items-center gap-3 mb-2">
          <span class="px-2 py-1 bg-cyan-blue/10 text-cyan-blue text-xs font-bold rounded">${item.type}</span>
          <h3 class="text-lg font-bold group-hover:text-cyan-blue transition">${item.title}</h3>
        </div>
        <p class="text-gray-600 dark:text-gray-400 text-sm line-clamp-2">${item.desc}</p>
      </a>
    `).join('');
  });
</script>
