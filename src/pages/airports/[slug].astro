---
import Layout from '../../layouts/Layout.astro';
import { airports } from '../../data/airports';
import StructuredData from '../../components/StructuredData.astro';
import AffiliateDisclosure from '../../components/AffiliateDisclosure.astro';
import { getLowestMonthlyPlan, getLowestQuarterlyPlan, getLowestAnnualPlan, getLowestDirectPayment } from '../../utils/airportPlanUtils';
import { getDisplayPrice } from '../../utils/airportPrice';

export async function getStaticPaths() {
  return airports.map((airport) => ({
    params: { slug: airport.slug },
    props: { airport },
  }));
}

const { airport } = Astro.props;

const lowestMonthly = getLowestMonthlyPlan(airport);
const lowestQuarterly = getLowestQuarterlyPlan(airport);
const lowestAnnual = getLowestAnnualPlan(airport);
const displayPriceText = getDisplayPrice(airport);

const schemaData = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": `${airport.name} 2026 套餐与线路资料`,
  "description": `2026年 ${airport.name} 的基础套餐资料、线路（${airport.lineType}）、价格（${displayPriceText}）、AI 与流媒体支持（${airport.aiSupport}/${airport.streamingSupport}）信息汇总。`,
  "author": {
    "@type": "Organization",
    "name": "机场湾"
  }
};
---
<Layout 
  title={`${airport.name}怎么样？2026套餐价格、线路与使用资料 - 机场湾`} 
  description={`2026年 ${airport.name} 基础资料整理，含套餐价格（${displayPriceText}）、线路（${airport.lineType}）、流媒体及 AI 支持情况等公开信息。`}
>
  <StructuredData type="Article" data={schemaData} />
  <StructuredData type="BreadcrumbList" data={{
    itemListElement: [
      { "@type": "ListItem", "position": 1, "name": "首页", "item": "https://jichangbay.biz/" },
      { "@type": "ListItem", "position": 2, "name": "所有机场", "item": "https://jichangbay.biz/airports/" },
      { "@type": "ListItem", "position": 3, "name": airport.name, "item": `https://jichangbay.biz/airports/${airport.slug}/` }
    ]
  }} />
  
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 relative pb-24 md:pb-12">
    <nav class="flex text-sm text-gray-500 mb-8 relative z-10" aria-label="Breadcrumb">
      <ol class="inline-flex items-center space-x-1 md:space-x-3">
        <li class="inline-flex items-center">
          <a href="/" class="hover:text-cyan-blue">首页</a>
        </li>
        <li>
          <div class="flex items-center">
            <svg class="w-3 h-3 text-gray-400 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/></svg>
            <a href="/airports/" class="hover:text-cyan-blue ml-1 md:ml-2">所有机场</a>
          </div>
        </li>
        <li>
          <div class="flex items-center">
            <svg class="w-3 h-3 text-gray-400 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/></svg>
            <span class="ml-1 md:ml-2 text-gray-700 dark:text-gray-300 font-medium">{airport.name}</span>
          </div>
        </li>
      </ol>
    </nav>

    <article class="bg-white dark:bg-midnight p-6 md:p-10 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-800 relative overflow-hidden">
      <!-- Background pattern -->
      <div class="absolute top-0 right-0 -mr-16 -mt-16 w-64 h-64 rounded-full bg-gradient-to-br from-cyan-blue/10 to-transparent blur-3xl pointer-events-none"></div>
      
      <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-8 border-b border-gray-100 dark:border-gray-800 pb-8 relative z-10">
        <div>
          <span class="px-3 py-1 bg-cyan-blue/10 text-cyan-blue text-xs font-bold tracking-wider uppercase rounded-full mb-4 inline-block">{airport.recommendedFor}</span>
          <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4 tracking-tight">
            {airport.name} <span class="text-2xl text-gray-400 font-normal ml-2">基础资料</span>
          </h1>
        </div>
      </div>
      
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10 relative z-10">
        <div class="bg-gray-50 dark:bg-gray-800/50 p-4 rounded-xl border border-gray-100 dark:border-gray-700">
          <div class="text-sm text-gray-500 mb-1">最低付款</div>
          <div class="text-xl font-bold text-coral">{displayPriceText}</div>
        </div>
        <div class="bg-gray-50 dark:bg-gray-800/50 p-4 rounded-xl border border-gray-100 dark:border-gray-700">
          <div class="text-sm text-gray-500 mb-1">主打线路</div>
          <div class="text-xl font-bold">{airport.lineType}</div>
        </div>
        <div class="bg-gray-50 dark:bg-gray-800/50 p-4 rounded-xl border border-gray-100 dark:border-gray-700">
          <div class="text-sm text-gray-500 mb-1">流媒体解锁</div>
          <div class="text-xl font-bold text-purple-500">{airport.streamingSupport}</div>
        </div>
        <div class="bg-gray-50 dark:bg-gray-800/50 p-4 rounded-xl border border-gray-100 dark:border-gray-700">
          <div class="text-sm text-gray-500 mb-1">AI 兼容性</div>
          <div class="text-xl font-bold text-green-500">{airport.aiSupport}</div>
        </div>
      </div>

      <AffiliateDisclosure />

      <div class="flex flex-col md:flex-row items-center justify-between bg-gradient-to-r from-cyan-blue/10 to-blue-500/10 border border-cyan-blue/30 p-6 rounded-xl mb-8 relative z-10">
        <div class="mb-4 md:mb-0">
          <div class="text-sm text-gray-600 dark:text-gray-400 mb-1">机场湾专属优惠码</div>
          <div class="text-2xl font-mono font-bold text-cyan-blue bg-white dark:bg-midnight px-3 py-1 rounded shadow-sm inline-block">{airport.coupon || '暂无优惠码，以官网结算页为准'}</div>
        </div>
        <a href={airport.affiliateUrl} target="_blank" rel="sponsored nofollow noopener" class="px-8 py-4 bg-coral hover:bg-red-500 text-white font-bold rounded-lg transition shadow-lg hover:shadow-xl w-full md:w-auto text-center transform hover:-translate-y-1">
          立即前往 {airport.name} 官网 &rarr;
        </a>
      </div>
      
      <div class="prose dark:prose-invert max-w-none">
        <h2>资料特点</h2>
        <p>本站数据库当前记录 <strong>{airport.name}</strong> 线路类型为 <strong>{airport.lineType}</strong>，最低付款方案约 <strong>{displayPriceText}</strong>。根据数据库标签，其对流媒体的支持状况为：<strong>{airport.streamingSupport}</strong>，对 ChatGPT/Claude 等 AI 平台的支持状况为：<strong>{airport.aiSupport}</strong>。</p>
        
        <h3>核心特性</h3>
        <ul>
          {airport.features.map((f: string) => <li>{f}</li>)}
        </ul>

        <h2>套餐列表</h2>
        <div class="overflow-x-auto not-prose mb-8">
          <table class="min-w-full text-sm text-left border-collapse border border-gray-200 dark:border-gray-700 rounded-lg hidden md:table">
            <thead class="bg-gray-100 dark:bg-gray-800">
              <tr>
                <th class="p-3 border border-gray-200 dark:border-gray-700">套餐名称</th>
                <th class="p-3 border border-gray-200 dark:border-gray-700">流量</th>
                <th class="p-3 border border-gray-200 dark:border-gray-700">月付</th>
                <th class="p-3 border border-gray-200 dark:border-gray-700">季付</th>
                <th class="p-3 border border-gray-200 dark:border-gray-700">半年付</th>
                <th class="p-3 border border-gray-200 dark:border-gray-700">年付</th>
                <th class="p-3 border border-gray-200 dark:border-gray-700">一次性</th>
              </tr>
            </thead>
            <tbody>
              {airport.plans && airport.plans.map((p: any) => (
                <tr class="hover:bg-gray-50 dark:hover:bg-gray-800/50">
                  <td class="p-3 border border-gray-200 dark:border-gray-700 font-bold">{p.name}</td>
                  <td class="p-3 border border-gray-200 dark:border-gray-700">{p.traffic}</td>
                  <td class="p-3 border border-gray-200 dark:border-gray-700">{p.monthly ? `¥${p.monthly}` : '-'}</td>
                  <td class="p-3 border border-gray-200 dark:border-gray-700">{p.quarterly ? `¥${p.quarterly}` : '-'}</td>
                  <td class="p-3 border border-gray-200 dark:border-gray-700">{p.semiannual ? `¥${p.semiannual}` : '-'}</td>
                  <td class="p-3 border border-gray-200 dark:border-gray-700">{p.annual ? `¥${p.annual}` : '-'}</td>
                  <td class="p-3 border border-gray-200 dark:border-gray-700">{p.oneTime ? `¥${p.oneTime}` : '-'}</td>
                </tr>
              ))}
            </tbody>
          </table>
          
          <div class="md:hidden space-y-4 mt-4">
            {airport.plans && airport.plans.map((p: any) => (
              <div class="bg-gray-50 dark:bg-gray-800 p-4 rounded-xl border border-gray-200 dark:border-gray-700">
                <div class="flex justify-between items-center mb-2 border-b border-gray-200 dark:border-gray-700 pb-2">
                  <div class="font-bold text-lg">{p.name}</div>
                  <div class="text-cyan-blue font-bold">{p.traffic}</div>
                </div>
                <div class="grid grid-cols-2 gap-2 text-sm">
                  {p.monthly && <div>月付: <span class="font-medium text-gray-900 dark:text-gray-100">¥{p.monthly}</span></div>}
                  {p.quarterly && <div>季付: <span class="font-medium text-gray-900 dark:text-gray-100">¥{p.quarterly}</span></div>}
                  {p.semiannual && <div>半年付: <span class="font-medium text-gray-900 dark:text-gray-100">¥{p.semiannual}</span></div>}
                  {p.annual && <div>年付: <span class="font-medium text-gray-900 dark:text-gray-100">¥{p.annual}</span></div>}
                  {p.oneTime && <div>一次性: <span class="font-medium text-gray-900 dark:text-gray-100">¥{p.oneTime}</span></div>}
                </div>
              </div>
            ))}
          </div>
        </div>

        <h3>客户端使用说明</h3>
        <p>不同服务商提供的订阅格式可能不同，购买前建议在服务商后台或官方教程确认是否兼容你使用的客户端。</p>
        {airport.macDownload && (
          <p><a href={airport.macDownload} target="_blank" rel="noopener noreferrer">获取相关 Mac 客户端入口</a></p>
        )}
        <p>更多跨平台客户端的配置教程，请参阅本站的 <a href="/clients">客户端指南</a>。</p>
      </div>
    </article>
    
    <div class="fixed bottom-0 left-0 w-full bg-white/90 dark:bg-midnight/90 backdrop-blur-md p-4 shadow-[0_-10px_40px_rgba(0,0,0,0.1)] border-t border-gray-200 dark:border-gray-800 md:hidden flex justify-between items-center z-50">
       <div class="flex flex-col">
         <span class="text-xs text-gray-500 font-bold uppercase">{airport.name}</span>
         <span class="font-bold text-coral text-lg">{displayPriceText}</span>
       </div>
       <a href={airport.affiliateUrl} target="_blank" rel="sponsored nofollow noopener" class="px-8 py-3 bg-cyan-blue text-white rounded-lg font-bold shadow-lg">直达官网</a>
    </div>
  </div>
</Layout>
