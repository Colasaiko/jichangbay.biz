---
import Layout from '../../layouts/Layout.astro';
import { airports } from '../../data/airports';

export function getStaticPaths() {
  return airports.map(airport => ({
    params: { slug: airport.slug },
    props: { airport },
  }));
}

const { airport } = Astro.props;
---
<Layout title={`${airport.name} 评测与优惠码：2026最新套餐与真实体验 - 机场湾`} description={`${airport.name} 怎么样？最新套餐价格 ¥${airport.startingPrice}/月起。包含${airport.name}优惠码、线路测速、流媒体解锁测试与客户端下载指引。`}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <nav class="text-sm mb-6 text-gray-500">
      <a href="/" class="hover:text-cyan-blue">首页</a> &gt; 
      <a href="/airports" class="hover:text-cyan-blue">品牌库</a> &gt; 
      <span class="text-gray-800 dark:text-gray-200">{airport.name}</span>
    </nav>
    
    <div class="bg-white dark:bg-midnight p-8 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-800 mb-8">
      <h1 class="text-3xl font-bold mb-4">{airport.name} 详情与测评</h1>
      <p class="text-lg text-gray-600 dark:text-gray-400 mb-6">{airport.recommendedFor}</p>
      
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
        <div class="bg-gray-50 dark:bg-gray-800/50 p-4 rounded-lg text-center">
          <div class="text-sm text-gray-500">起步价格</div>
          <div class="text-xl font-bold text-coral">¥{airport.startingPrice}/月</div>
        </div>
        <div class="bg-gray-50 dark:bg-gray-800/50 p-4 rounded-lg text-center">
          <div class="text-sm text-gray-500">线路类型</div>
          <div class="text-xl font-bold">{airport.lineType}</div>
        </div>
        <div class="bg-gray-50 dark:bg-gray-800/50 p-4 rounded-lg text-center">
          <div class="text-sm text-gray-500">流媒体解锁</div>
          <div class="text-xl font-bold text-purple-500">{airport.streamingSupport}</div>
        </div>
        <div class="bg-gray-50 dark:bg-gray-800/50 p-4 rounded-lg text-center">
          <div class="text-sm text-gray-500">AI 支持</div>
          <div class="text-xl font-bold text-green-500">{airport.aiSupport}</div>
        </div>
      </div>

      <div class="flex flex-col md:flex-row items-center justify-between bg-cyan-blue/10 border border-cyan-blue/20 p-6 rounded-xl mb-8">
        <div class="mb-4 md:mb-0">
          <div class="text-sm text-gray-600 dark:text-gray-400">专属优惠码</div>
          <div class="text-2xl font-mono font-bold text-cyan-blue">{airport.coupon || '暂无专属优惠码'}</div>
        </div>
        <a href={airport.affiliateUrl} target="_blank" rel="sponsored nofollow noopener" class="px-8 py-4 bg-coral hover:bg-red-500 text-white font-bold rounded-lg transition shadow-lg hover:shadow-xl w-full md:w-auto text-center">
          前往官网购买 &rarr;
        </a>
      </div>
      
      <div class="prose dark:prose-invert max-w-none">
        <h2>核心特点</h2>
        <ul>
          {airport.features.map(f => <li>{f}</li>)}
        </ul>
        
        <h2>模拟测试数据 (示例)</h2>
        <p class="text-sm text-gray-500 italic">模拟测试数据 / 示例环境，仅用于展示页面结构，实际表现因网络环境而异。</p>
        <div class="overflow-x-auto">
          <table class="min-w-full text-sm text-left">
            <thead class="bg-gray-100 dark:bg-gray-800">
              <tr>
                <th class="p-2">节点</th>
                <th class="p-2">地区</th>
                <th class="p-2">TLS RTT</th>
                <th class="p-2">平均速度</th>
              </tr>
            </thead>
            <tbody>
              <tr class="border-b dark:border-gray-700"><td class="p-2">{airport.name} - 01</td><td class="p-2">香港</td><td class="p-2 text-green-500">45ms</td><td class="p-2">800 Mbps</td></tr>
              <tr class="border-b dark:border-gray-700"><td class="p-2">{airport.name} - 02</td><td class="p-2">日本</td><td class="p-2 text-green-500">65ms</td><td class="p-2">600 Mbps</td></tr>
              <tr class="border-b dark:border-gray-700"><td class="p-2">{airport.name} - 03</td><td class="p-2">美国</td><td class="p-2 text-yellow-500">145ms</td><td class="p-2">450 Mbps</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
    
    <div class="fixed bottom-0 left-0 w-full bg-white dark:bg-midnight p-4 shadow-[0_-10px_40px_rgba(0,0,0,0.1)] md:hidden flex justify-between items-center z-50">
       <div class="font-bold text-coral">¥{airport.startingPrice}/月</div>
       <a href={airport.affiliateUrl} target="_blank" rel="sponsored nofollow noopener" class="px-6 py-2 bg-cyan-blue text-white rounded font-bold">立即查看</a>
    </div>
  </div>
</Layout>
