---
import Layout from '../../layouts/Layout.astro';
import StructuredData from '../../components/StructuredData.astro';

const faqs = [
  { q: "机场是什么？为什么不用 VPN？", a: "所谓“机场”，通常是指提供 Shadowsocks、V2Ray、Trojan 等新型代理协议的服务商。相较于传统的 VPN（如 ExpressVPN、NordVPN），机场协议在面对 GFW 的深度包检测（DPI）时具有更强的隐蔽性，速度和稳定性在 2026 年远超传统 VPN。" },
  { q: "专线机场（IPLC/IEPL）到底好在哪里？", a: "普通的公网中转节点在晚高峰（晚上 8 点至 11 点）会因为公网拥堵导致严重的丢包。而 IPLC（国际私有租用线路）和 IEPL 是通过点对点的物理专线传输，彻底绕过了公网拥堵，能保证全天候的超低延迟与零丢包，是游戏和 4K 秒开的最佳选择。" },
  { q: "看 Netflix、Disney+ 为什么要专门选流媒体解锁机场？", a: "Netflix 等平台对访问者的 IP 有严格的限制（封锁机房 IP）。如果节点不支持解锁，你将只能看到自制剧，或者完全无法播放。优秀的机场会通过 DNS 劫持等技术解锁流媒体库，让你畅享完整内容。" },
  { q: "为什么推荐使用 Clash 或 Shadowrocket 而不是官网自带客户端？", a: "大部分商家提供的一键客户端基于老旧内核，且不支持多机场同时订阅。而开源的第三方客户端（如 Clash Verge、Shadowrocket）支持强大的分流规则（国内直连，国外走代理），并且可以随时切换不同商家的节点，安全性与灵活性更高。" },
  { q: "节点显示超时（Timeout）怎么办？", a: "首先请确认你的订阅是否已过期或流量已用完。其次，尝试在客户端中执行“更新订阅”操作。如果更新后依然全部超时，请登录商家官网查看是否有最新公告或更换订阅链接。" }
];

const schemaData = {
  mainEntity: faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
};
---
<Layout title="机场知识与常见问题百科 - 机场湾" description="新手如何购买和使用梯子？专线和中转的区别是什么？了解最全的科学上网知识与常见问题解答。">
  <StructuredData type="FAQPage" data={schemaData} />
  
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-12 text-center">
      <h1 class="text-4xl font-bold mb-4">常见问题百科 (FAQ)</h1>
      <p class="text-lg text-gray-600 dark:text-gray-400">汇集了从新手入门到高阶进阶的所有网络工具使用知识。</p>
    </div>
    
    <div class="bg-white dark:bg-midnight rounded-2xl shadow-sm border border-gray-100 dark:border-gray-800 p-8">
      <div class="space-y-6">
        {faqs.map(faq => (
          <details class="group bg-gray-50 dark:bg-gray-800/50 rounded-xl p-6 cursor-pointer border border-transparent hover:border-cyan-blue/30 transition">
            <summary class="font-bold text-lg flex justify-between items-center outline-none">
              {faq.q}
              <span class="text-cyan-blue group-open:rotate-180 transition-transform">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
              </span>
            </summary>
            <div class="mt-4 text-gray-600 dark:text-gray-400 leading-relaxed border-t border-gray-200 dark:border-gray-700 pt-4">
              {faq.a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</Layout>
