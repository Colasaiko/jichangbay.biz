---
import Layout from '../layouts/Layout.astro';
import { airports } from '../data/airports';
const featuredAirports = airports.slice(0, 8);
---
<Layout title="2026 机场推荐：稳定、便宜与专线机场选择指南 - 机场湾" description="2026机场推荐、稳定机场、便宜机场、专线机场、Clash、梯子、VPN、套餐价格、优惠码、AI与流媒体。提供最新机场排行与测速数据。">
  <div class="bg-gradient-to-b from-deep-sea to-midnight text-white py-20 relative overflow-hidden">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 32px 32px;"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 flex flex-col md:flex-row items-center">
      <div class="md:w-1/2 pr-8">
        <span class="inline-block py-1 px-3 rounded-full bg-cyan-blue bg-opacity-20 text-cyan-blue text-sm font-semibold mb-6">2026 年持续更新 · 29个品牌资料</span>
        <h1 class="text-4xl md:text-5xl font-bold leading-tight mb-6">2026 机场推荐：<br/><span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-blue to-coral">稳定、便宜与专线机场</span><br/>选择指南</h1>
        <p class="text-lg text-gray-300 mb-8">在这里，找到最适合你的科学上网工具。从低预算到全能专线，全面解锁 Netflix、ChatGPT，支持 Clash、Shadowrocket 多端协同。</p>
        <div class="flex flex-wrap gap-4">
          <a href="/airports" class="px-6 py-3 bg-cyan-blue hover:bg-blue-600 text-white font-bold rounded-lg transition">查看机场排行榜</a>
          <a href="/compare" class="px-6 py-3 bg-white bg-opacity-10 hover:bg-opacity-20 text-white font-bold rounded-lg transition border border-white border-opacity-20">按预算与需求筛选</a>
        </div>
      </div>
      <div class="md:w-1/2 mt-12 md:mt-0">
        <div class="bg-white bg-opacity-5 p-6 rounded-2xl backdrop-blur-md border border-white border-opacity-10 shadow-2xl">
          <h3 class="text-xl font-bold mb-4 flex items-center"><span class="w-2 h-2 bg-green-400 rounded-full mr-2 animate-pulse"></span>2026 Airport Radar</h3>
          <div class="space-y-4">
            <div class="flex justify-between items-center"><span class="text-sm">稳定性指标</span><div class="w-48 h-2 bg-gray-700 rounded-full overflow-hidden"><div class="bg-cyan-blue h-full" style="width: 95%"></div></div></div>
            <div class="flex justify-between items-center"><span class="text-sm">流媒体解锁</span><div class="w-48 h-2 bg-gray-700 rounded-full overflow-hidden"><div class="bg-purple-500 h-full" style="width: 90%"></div></div></div>
            <div class="flex justify-between items-center"><span class="text-sm">AI 兼容性</span><div class="w-48 h-2 bg-gray-700 rounded-full overflow-hidden"><div class="bg-green-500 h-full" style="width: 98%"></div></div></div>
            <div class="flex justify-between items-center"><span class="text-sm">性价比均值</span><div class="w-48 h-2 bg-gray-700 rounded-full overflow-hidden"><div class="bg-coral h-full" style="width: 85%"></div></div></div>
          </div>
          <p class="text-xs text-gray-400 mt-4 text-center">* 视觉组件示例，基于本站数据库综合计算</p>
        </div>
      </div>
    </div>
  </div>

  <section class="py-16 bg-fog-white dark:bg-deep-sea">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold mb-4">30 秒快速选择</h2>
        <p class="text-gray-600 dark:text-gray-400">不知道怎么选？按你的核心需求直接匹配最适合的机场套餐。</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {[
          {name: '预算最低', link: '/recommend/cheap-airport', icon: '💰'},
          {name: '稳定优先', link: '/recommend/stable-airport', icon: '🛡️'},
          {name: '专线优先', link: '/recommend/premium-line', icon: '🚀'},
          {name: '新手推荐', link: '/recommend/ladder', icon: '👶'},
          {name: 'AI / ChatGPT', link: '/recommend/ai', icon: '🤖'},
          {name: '流媒体解锁', link: '/recommend/streaming', icon: '📺'},
          {name: '大流量需求', link: '/recommend/unlimited', icon: '📈'},
          {name: '按量/不限时', link: '/recommend/pay-as-you-go', icon: '⏳'},
        ].map(item => (
          <a href={item.link} class="bg-white dark:bg-midnight p-6 rounded-xl shadow-sm hover:shadow-md transition border border-gray-100 dark:border-gray-800 flex flex-col items-center text-center group">
            <span class="text-3xl mb-3 group-hover:scale-110 transition-transform">{item.icon}</span>
            <span class="font-bold">{item.name}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-end mb-8">
        <div>
          <h2 class="text-3xl font-bold mb-2">2026 机场排行榜</h2>
          <p class="text-gray-600 dark:text-gray-400">编辑部严选，综合速度、稳定、价格与售后评分</p>
        </div>
        <a href="/airports" class="text-cyan-blue hover:underline hidden md:block">查看完整 29 个品牌库 &rarr;</a>
      </div>
      
      <div class="overflow-x-auto pb-4">
        <div class="min-w-[800px] bg-white dark:bg-midnight rounded-xl shadow-sm border border-gray-100 dark:border-gray-800 overflow-hidden">
          <div class="grid grid-cols-12 gap-4 p-4 border-b border-gray-100 dark:border-gray-800 bg-gray-50 dark:bg-gray-800/50 font-bold text-sm">
            <div class="col-span-2">品牌</div>
            <div class="col-span-2">推荐定位</div>
            <div class="col-span-1">起步价</div>
            <div class="col-span-1">线路</div>
            <div class="col-span-1">AI</div>
            <div class="col-span-1">流媒体</div>
            <div class="col-span-2">优惠码</div>
            <div class="col-span-2 text-right">操作</div>
          </div>
          {featuredAirports.map((airport) => (
            <div class="grid grid-cols-12 gap-4 p-4 border-b border-gray-50 dark:border-gray-800 items-center hover:bg-gray-50 dark:hover:bg-gray-800/30 transition text-sm">
              <div class="col-span-2 font-bold text-lg"><a href={`/airports/${airport.slug}`} class="hover:text-cyan-blue">{airport.name}</a></div>
              <div class="col-span-2 text-gray-500 dark:text-gray-400"><span class="px-2 py-1 bg-gray-100 dark:bg-gray-700 rounded text-xs">{airport.recommendedFor}</span></div>
              <div class="col-span-1 text-coral font-bold">¥{airport.startingPrice}/月</div>
              <div class="col-span-1">{airport.lineType}</div>
              <div class="col-span-1 text-green-500">{airport.aiSupport}</div>
              <div class="col-span-1 text-purple-500">{airport.streamingSupport}</div>
              <div class="col-span-2 font-mono text-xs bg-gray-100 dark:bg-gray-800 px-2 py-1 rounded inline-block w-max">{airport.coupon || '暂无'}</div>
              <div class="col-span-2 text-right flex justify-end space-x-2">
                <a href={`/airports/${airport.slug}`} class="px-3 py-1 bg-gray-200 dark:bg-gray-700 hover:bg-gray-300 dark:hover:bg-gray-600 rounded transition">详情</a>
                <a href={airport.affiliateUrl} target="_blank" rel="sponsored nofollow noopener" class="px-3 py-1 bg-coral hover:bg-red-500 text-white rounded transition">官网</a>
              </div>
            </div>
          ))}
        </div>
      </div>
      <div class="mt-4 text-center md:hidden">
        <a href="/airports" class="text-cyan-blue hover:underline">查看完整品牌库 &rarr;</a>
      </div>
    </div>
  </section>
</Layout>
