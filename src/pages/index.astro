---
import Layout from '../layouts/Layout.astro';
import { airports } from '../data/airports'; 
import { getDisplayPrice } from '../utils/airportPrice';
import { getRankedAirports } from '../utils/airportRanking';
import { getCollection } from 'astro:content';

const featuredAirports = getRankedAirports().slice(0, 8);
const posts = await getCollection('blog');

  

const latestPosts = [...posts].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 4);
---
<Layout title="2026 机场推荐：稳定、便宜与专线机场排行榜 - 机场湾" description="2026机场推荐与套餐资料整理，收录29个品牌，提供便宜机场、稳定机场、专线机场、Clash客户端、套餐对比和常见问题指南。">
  <!-- 1. Hero & 2. 2026 更新状态 -->
  <div class="bg-gradient-to-b from-deep-sea to-midnight text-white py-20 relative overflow-hidden">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 32px 32px;"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 flex flex-col md:flex-row items-center">
      <div class="md:w-1/2 pr-8">
        <span class="inline-block py-1 px-3 rounded-full bg-cyan-blue/20 text-cyan-blue border border-cyan-blue/30 text-sm font-semibold mb-6 shadow-sm">🚀 2026 年资料持续更新 · 严选收录 29 个品牌</span>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-6">2026 机场推荐与<br/><span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-blue to-coral">网络加速器</span>选择指南</h1>
        <p class="text-lg text-gray-300 mb-8 leading-relaxed">在这个信息爆炸的时代，打破网络边界是每个数字公民的必修课。从极致稳定的 IPLC 专线到性价比爆棚的便宜中转，我们为你提供最全面的套餐资料参考。</p>
        <div class="flex flex-wrap gap-4">
          <a href="/airports" class="px-6 py-3 bg-cyan-blue hover:bg-blue-600 text-white font-bold rounded-lg transition shadow-lg hover:shadow-cyan-blue/20">查看完整排行榜</a>
          <a href="/compare" class="px-6 py-3 bg-white/10 hover:bg-white/20 text-white font-bold rounded-lg transition border border-white/20 backdrop-blur-sm">打开套餐对比器</a>
        </div>
      </div>
      <div class="md:w-1/2 mt-12 md:mt-0">
        <div class="bg-white/5 p-8 rounded-2xl backdrop-blur-md border border-white/10 shadow-2xl relative">
          <div class="absolute -top-4 -right-4 w-20 h-20 bg-coral/30 rounded-full blur-2xl"></div>
          <h3 class="text-xl font-bold mb-6 flex items-center"><span class="w-2 h-2 bg-green-400 rounded-full mr-3 animate-pulse shadow-[0_0_8px_rgba(74,222,128,0.8)]"></span>实时收录数据看板</h3>
          <div class="space-y-5">
            <div class="flex justify-between items-center"><span class="text-sm text-gray-300 font-medium">当前收录品牌</span><span class="text-xl font-bold text-cyan-blue">29 家</span></div>
            <div class="flex justify-between items-center"><span class="text-sm text-gray-300 font-medium">问题百科条目</span><span class="text-xl font-bold text-purple-500">249 条</span></div>
            <div class="flex justify-between items-center"><span class="text-sm text-gray-300 font-medium">P0 深度解决指南</span><span class="text-xl font-bold text-green-500">30 篇</span></div>
            <div class="flex justify-between items-center"><span class="text-sm text-gray-300 font-medium">基础套餐数据</span><span class="text-sm font-bold text-coral">来自公开资料整理</span></div>
          </div>
          <div class="mt-6 pt-4 border-t border-white/10 text-xs text-gray-400 text-center">注：未独立核验的实际表现指标仅供参考</div>
        </div>
      </div>
    </div>
  </div>

  <!-- 3. 30 秒快速选择 -->
  <section class="py-16 bg-fog-white dark:bg-deep-sea">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold mb-4">30 秒快速定位需求</h2>
        <p class="text-gray-600 dark:text-gray-400">不知道怎么选？按你的核心使用场景，直接匹配最适合的方案。</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {[
          {name: '预算最低 (15元内)', link: '/recommend/cheap-airport', icon: '💰'},
          {name: '稳定优先 (防失联)', link: '/recommend/stable-airport', icon: '🛡️'},
          {name: '专线优先 (低延迟)', link: '/recommend/premium-line', icon: '🚀'},
          {name: '新手梯子 (免配置)', link: '/recommend/ladder', icon: '👶'},
          {name: 'AI / ChatGPT', link: '/recommend/ai', icon: '🤖'},
          {name: '流媒体视频解锁', link: '/recommend/streaming', icon: '📺'},
          {name: '大流量刷剧', link: '/recommend/unlimited', icon: '📈'},
          {name: '按量/不限时', link: '/recommend/pay-as-you-go', icon: '⏳'},
        ].map(item => (
          <a href={item.link} class="bg-white dark:bg-midnight p-6 rounded-2xl shadow-sm hover:shadow-lg transition-all border border-gray-100 dark:border-gray-800 flex flex-col items-center text-center group transform hover:-translate-y-1">
            <span class="text-4xl mb-4 group-hover:scale-110 transition-transform">{item.icon}</span>
            <span class="font-bold text-gray-800 dark:text-gray-200">{item.name}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. 2026 机场排行榜 (Top 8) -->
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-end mb-8">
        <div>
          <h2 class="text-3xl font-bold mb-2">2026 综合排行榜</h2>
          <p class="text-gray-600 dark:text-gray-400">编辑部严选，结合公开套餐与价格指标排序，适合绝大多数用户。</p>
        </div>
        <a href="/airports" class="text-cyan-blue hover:underline font-medium hidden md:block">查看完整 29 个品牌评测 &rarr;</a>
      </div>
      
      <div class="overflow-x-auto pb-4">
        <div class="min-w-[900px] bg-white dark:bg-midnight rounded-xl shadow-sm border border-gray-100 dark:border-gray-800 overflow-hidden">
          <div class="grid grid-cols-12 gap-4 p-4 border-b border-gray-100 dark:border-gray-800 bg-gray-50 dark:bg-gray-800/50 font-bold text-sm text-gray-500 dark:text-gray-400 uppercase tracking-wider">
            <div class="col-span-2">品牌名称</div>
            <div class="col-span-2">推荐定位</div>
            <div class="col-span-1">起步价</div>
            <div class="col-span-1">线路</div>
            <div class="col-span-1">AI支持</div>
            <div class="col-span-1">流媒体</div>
            <div class="col-span-2">专属优惠码</div>
            <div class="col-span-2 text-right">操作</div>
          </div>
          {featuredAirports.map((airport, index) => (
            <div class="grid grid-cols-12 gap-4 p-4 border-b border-gray-50 dark:border-gray-800 items-center hover:bg-gray-50 dark:hover:bg-gray-800/30 transition text-sm">
              <div class="col-span-2 font-bold text-lg text-gray-900 dark:text-white"><div class="flex flex-col"><a href={`/airports/${airport.slug}`} class="hover:text-cyan-blue flex items-center gap-2">{airport.name}</a>
   {index === 0 && <span class="text-xs bg-red-100 dark:bg-red-900/30 text-red-600 dark:text-red-400 px-1 py-0.5 rounded font-bold mt-1 w-max">#1 编辑首选</span>}
   {index === 1 && <span class="text-xs bg-orange-100 dark:bg-orange-900/30 text-orange-600 dark:text-orange-400 px-1 py-0.5 rounded font-bold mt-1 w-max">#2 综合推荐</span>}
   {index > 1 && <span class="text-xs text-gray-400 mt-1 w-max">#{index + 1}</span>}
   </div></div>
              <div class="col-span-2 text-gray-500 dark:text-gray-400"><span class="px-2 py-1 bg-gray-100 dark:bg-gray-700 rounded text-xs">{airport.recommendedFor}</span></div>
              <div class="col-span-1 text-coral font-bold text-base">{getDisplayPrice(airport)}</div>
              <div class="col-span-1 font-medium">{airport.lineType}</div>
              <div class="col-span-1 text-green-500 font-medium">{airport.aiSupport}</div>
              <div class="col-span-1 text-purple-500 font-medium">{airport.streamingSupport}</div>
              <div class="col-span-2 font-mono text-xs bg-gray-100 dark:bg-gray-800 px-2 py-1.5 rounded inline-block w-max text-cyan-blue font-bold">{airport.coupon || '暂无优惠码'}</div>
              <div class="col-span-2 text-right flex justify-end space-x-2">
                <a href={`/airports/${airport.slug}`} class="px-3 py-1.5 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 rounded transition font-medium">详情</a>
                <a href={airport.affiliateUrl} target="_blank" rel="sponsored nofollow noopener" class="px-3 py-1.5 bg-coral hover:bg-red-500 text-white rounded transition shadow-sm font-medium">前往官网</a>
              </div>
            </div>
          ))}
        </div>
      </div>
      <div class="mt-6 text-center">
        <a href="/airports" class="inline-block px-8 py-3 bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 text-gray-800 dark:text-gray-200 font-bold rounded-lg transition">探索更多品牌</a>
      </div>
    </div>
  </section>

  <!-- 8 & 12. 专区指引 -->
  <section class="py-16 bg-white dark:bg-midnight border-y border-gray-100 dark:border-gray-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="bg-gradient-to-br from-cyan-blue/10 to-blue-500/10 p-8 rounded-2xl border border-cyan-blue/20">
        <h3 class="text-2xl font-bold mb-4 text-cyan-blue">客户端使用专区</h3>
        <p class="text-gray-600 dark:text-gray-400 mb-6">不会配置客户端？无论是 Windows 的 Clash Verge，还是 iOS 的 Shadowrocket 小火箭，这里都有详尽的图文教程，教你如何一键导入订阅节点。</p>
        <div class="flex gap-4">
          <a href="/clients" class="px-4 py-2 bg-cyan-blue text-white font-bold rounded shadow hover:bg-blue-600 transition">访问教程中心</a>
          <a href="/recommend/clash" class="px-4 py-2 bg-white dark:bg-gray-800 font-bold rounded shadow hover:bg-gray-50 dark:hover:bg-gray-700 transition">找 Clash 节点</a>
        </div>
      </div>
      <div class="bg-gradient-to-br from-purple-500/10 to-pink-500/10 p-8 rounded-2xl border border-purple-500/20">
        <h3 class="text-2xl font-bold mb-4 text-purple-500">流媒体与 AI 专区</h3>
        <p class="text-gray-600 dark:text-gray-400 mb-6">想看 4K Netflix？还是需要干净的原生 IP 注册 ChatGPT 和 Claude？我们为你单独整理了那些能够整理的支持 AI 或流媒体的专项方案。</p>
        <div class="flex gap-4">
          <a href="/recommend/streaming" class="px-4 py-2 bg-purple-500 text-white font-bold rounded shadow hover:bg-purple-600 transition">流媒体节点</a>
          <a href="/recommend/ai" class="px-4 py-2 bg-white dark:bg-gray-800 font-bold rounded shadow hover:bg-gray-50 dark:hover:bg-gray-700 transition">AI 节点</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 9. 最新文章 -->
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-end mb-8">
        <div>
          <h2 class="text-3xl font-bold mb-2">编辑部精选文章</h2>
          <p class="text-gray-600 dark:text-gray-400">深入了解网络原理、避坑指南与行业黑幕。</p>
        </div>
        <a href="/blog" class="text-cyan-blue hover:underline font-medium">查看所有文章 &rarr;</a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {latestPosts.map(post => (
          <a href={`/blog/${post.slug}`} class="group block bg-white dark:bg-midnight rounded-xl shadow-sm hover:shadow-lg transition-all border border-gray-100 dark:border-gray-800 overflow-hidden transform hover:-translate-y-1">
            <div class="h-32 bg-gray-100 dark:bg-gray-800 relative overflow-hidden">
               <div class="absolute inset-0 bg-gradient-to-tr from-cyan-blue/20 to-coral/20 group-hover:scale-110 transition-transform duration-500"></div>
            </div>
            <div class="p-6">
              <span class="text-xs text-cyan-blue font-bold tracking-wider uppercase mb-2 block">{post.data.category}</span>
              <h3 class="text-lg font-bold mb-2 group-hover:text-cyan-blue transition line-clamp-2">{post.data.title}</h3>
              <p class="text-sm text-gray-500 line-clamp-2">{post.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
  
  <!-- 17. 关于机场湾 -->
  <section class="py-16 bg-white dark:bg-midnight border-t border-gray-100 dark:border-gray-800">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold mb-6">关于机场湾</h2>
      <p class="text-gray-600 dark:text-gray-400 leading-relaxed mb-8">机场湾 (jichangbay.biz) 成立于网络环境巨变的时代。我们的目标是打破信息壁垒，整理基础的品牌资料与套餐数据，以减少信息差。我们深知在海量商家中筛选出优质服务有多么困难，因此我们试图搭建一个兼具公开信息与多维比对的分类导航体系。</p>
      <a href="/about" class="inline-block px-6 py-2 border border-gray-300 dark:border-gray-700 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-800 transition font-medium">了解我们的评测标准</a>
    </div>
  </section>
</Layout>
