---
import { airports } from "../../data/airports";
import Layout from "../../layouts/Layout.astro";

export function getStaticPaths() {
  return airports.map((airport) => ({
    params: { slug: airport.slug },
    props: { airport },
  }));
}

const { airport } = Astro.props;
// SEO title and meta to prevent indexing of redirect pages
const title = `正在前往 ${airport.name} 官网...`;
const description = `正在前往 ${airport.name}，请稍候...`;
---

<Layout title={title} description={description} noindex={true}>
  <div class="max-w-2xl mx-auto py-24 px-4 sm:px-6 lg:px-8 text-center min-h-[60vh] flex flex-col justify-center">
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8 md:p-12 relative overflow-hidden">
      <!-- Loading animation -->
      <div class="absolute top-0 left-0 w-full h-1 bg-gray-100">
        <div class="h-full bg-blue-600 transition-all duration-[3000ms] ease-linear w-0" id="progress-bar"></div>
      </div>
      
      <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-blue-50 text-blue-600 mb-6">
        <svg class="w-8 h-8 animate-spin" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
      </div>

      <h1 class="text-2xl font-bold text-gray-900 mb-2">正在前往 {airport.name}</h1>
      <p class="text-gray-500 mb-8">即将离开 JichangBay.biz，前往合作伙伴网站</p>
      
      <div class="text-sm text-gray-400">
        <span id="countdown">3</span> 秒后自动跳转...
      </div>
      
      <div class="mt-8 pt-6 border-t border-gray-50">
        <p class="text-xs text-gray-400">
          如果浏览器没有自动跳转，请<a href={airport.realAffiliateUrl} class="text-blue-600 hover:underline" rel="nofollow">点击此处手动访问</a>。
        </p>
      </div>
    </div>
  </div>
</Layout>

<script define:vars={{ targetUrl: airport.realAffiliateUrl }}>
  document.addEventListener('DOMContentLoaded', () => {
    // Start progress bar
    setTimeout(() => {
      const progressBar = document.getElementById('progress-bar');
      if (progressBar) progressBar.style.width = '100%';
    }, 50);

    // Countdown
    let seconds = 3;
    const countdownEl = document.getElementById('countdown');
    
    const interval = setInterval(() => {
      seconds--;
      if (countdownEl) countdownEl.textContent = seconds;
      
      if (seconds <= 0) {
        clearInterval(interval);
        window.location.href = targetUrl;
      }
    }, 1000);
  });
</script>


