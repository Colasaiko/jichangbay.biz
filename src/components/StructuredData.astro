---
export interface Props {
  type: 'WebSite' | 'Organization' | 'Article' | 'FAQPage';
  data: any;
}
const { type, data } = Astro.props;

let schemaData = {
  "@context": "https://schema.org",
  "@type": type,
  ...data
};
---
<script type="application/ld+json" set:html={JSON.stringify(schemaData)}></script>
